FROM docker.io/pytorch/pytorch:2.14.1-cuda13.0-cudnn9-runtime
ENV NVIDIA_VISIBLE_DEVICES=all NVIDIA_DRIVER_CAPABILITIES=compute,utility
RUN pip install --no-cache-dir --break-system-packages transformers==5.20.2 huggingface_hub==2.3.0 numpy==2.5.4
ENV HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 ESMC_MODEL=/opt/model
RUN HF_HUB_OFFLINE=0 python3 -I -c "from huggingface_hub import snapshot_download; snapshot_download('biohub/ESMC-600M', revision='fcc9d36f5fff97d9bb69a36e3252de61cc78c968', local_dir='/opt/model', allow_patterns=['*.json', '*.safetensors'])"
COPY --chmod=755 bin/esmc /usr/local/bin/esmc
COPY test /toolshed/test
