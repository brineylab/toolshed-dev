#!/usr/bin/env -S python3 -I
"""esmc: pseudo-log-likelihoods, embeddings, and masked infilling with the ESM C model in $ESMC_MODEL."""
import argparse, os, sys

import numpy as np
import torch
from transformers import AutoTokenizer, EsmcForMaskedLM
from transformers.utils import logging

logging.disable_progress_bar()

MAX_RESIDUES = 2046  # the model's 2048 positions, less <cls> and <eos>
BATCH = 32           # masked copies per forward pass in pll
RESIDUES = "ACDEFGHIKLMNPQRSTVWY"


def read_fasta(path):
    records = []
    for line in open(path):
        line = line.strip()
        if line.startswith(">"):
            records.append([line[1:].split()[0] if line[1:].strip() else f"seq{len(records) + 1}", ""])
        elif line:
            if not records:
                sys.exit(f"esmc: {path} is not FASTA: sequence before the first '>'")
            records[-1][1] += line.upper().replace("<MASK>", "<mask>").replace("_", "<mask>")
    if not records:
        sys.exit(f"esmc: {path} holds no sequences")
    return records


def encode(tok, name, seq, device):
    ids = tok(seq, return_tensors="pt")["input_ids"].to(device)
    if ids.shape[1] - 2 > MAX_RESIDUES:
        sys.exit(f"esmc: {name} has {ids.shape[1] - 2} residues; the model takes at most {MAX_RESIDUES}")
    return ids


def pll(model, tok, ids):
    """Each position masked in turn; the true residue's log-probability there, summed."""
    total, L = 0.0, ids.shape[1] - 2
    for start in range(1, L + 1, BATCH):
        pos = torch.arange(start, min(start + BATCH, L + 1), device=ids.device)
        rows = torch.arange(len(pos), device=ids.device)
        batch = ids.repeat(len(pos), 1)
        batch[rows, pos] = tok.mask_token_id
        logp = model(input_ids=batch).logits.log_softmax(-1)
        total += logp[rows, pos, ids[0, pos]].sum().item()
    return total


def embed(model, ids):
    """The last layer, mean-pooled over residues."""
    return model.base_model(input_ids=ids).last_hidden_state[0, 1:-1].mean(0).float().cpu().numpy()


def fill(model, tok, ids):
    """Every <mask> replaced by the most likely of the 20 standard residues."""
    allowed = torch.tensor(tok.convert_tokens_to_ids(list(RESIDUES)), device=ids.device)
    logits = model(input_ids=ids).logits[0][:, allowed]
    out = ids[0].clone()
    masked = out == tok.mask_token_id
    out[masked] = allowed[logits[masked].argmax(-1)]
    return "".join(tok.convert_ids_to_tokens(out[1:-1].tolist()))


def main():
    ap = argparse.ArgumentParser(prog="esmc", description=__doc__)
    sub = ap.add_subparsers(dest="cmd", required=True)
    for cmd, out in (("pll", "TSV: id, pll"), ("embed", "npz: ids, embeddings"), ("fill", "FASTA")):
        p = sub.add_parser(cmd)
        p.add_argument("--in", dest="inp", required=True, help="FASTA")
        p.add_argument("--out", required=True, help=out)
        p.add_argument("--device", default="cuda" if torch.cuda.is_available() else "cpu")
    args = ap.parse_args()

    records = read_fasta(args.inp)
    tok = AutoTokenizer.from_pretrained(os.environ["ESMC_MODEL"])
    model = EsmcForMaskedLM.from_pretrained(os.environ["ESMC_MODEL"]).eval().to(args.device)
    with torch.inference_mode():
        results = [(name, encode(tok, name, seq, args.device)) for name, seq in records]
        if args.cmd == "pll":
            with open(args.out, "w") as f:
                f.write("id\tpll\n")
                for name, ids in results:
                    f.write(f"{name}\t{pll(model, tok, ids):.4f}\n")
        elif args.cmd == "embed":
            np.savez(args.out, ids=np.array([n for n, _ in results]),
                     embeddings=np.stack([embed(model, ids) for _, ids in results]).astype(np.float32))
        else:
            with open(args.out, "w") as f:
                for name, ids in results:
                    f.write(f">{name}\n{fill(model, tok, ids)}\n")


if __name__ == "__main__":
    main()
